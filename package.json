{
	"name": "@underactive/pi-topping-web-tools",
	"version": "0.2.0",
	"description": "Pi extensions for the web: fetch_markdown (URL to markdown, cached, keyless), pdf_extract (PDF text extraction) and web_browser (headless Playwright automation), sharing a preapproved-host allowlist.",
	"keywords": ["pi-package", "pi-extension"],
	"license": "MIT",
	"author": "Eric Sison",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/underactive/pi-topping-web-tools.git"
	},
	"bugs": {
		"url": "https://github.com/underactive/pi-topping-web-tools/issues"
	},
	"homepage": "https://github.com/underactive/pi-topping-web-tools#readme",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src/**/*.ts",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --test test/*.test.ts"
	},
	"pi": {
		"extensions": [
			"./src/fetch-markdown.ts",
			"./src/pdf-extract.ts",
			"./src/web-browser/index.ts",
			"./src/web-permissions.ts"
		]
	},
	"dependencies": {
		"@mozilla/readability": "^0.6.0",
		"linkedom": "^0.18.13",
		"lru-cache": "^11.0.0",
		"playwright": "^1.52.0",
		"turndown": "^7.2.0",
		"unpdf": "^1.8.1"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.82.1",
		"@earendil-works/pi-coding-agent": "0.82.1",
		"@earendil-works/pi-tui": "0.82.1",
		"@types/node": "^24.0.0",
		"@types/turndown": "^5.0.5",
		"typebox": "^1.3.3",
		"typescript": "^5.9.3"
	}
}
